{
  "$description": "FusionStructure · tokens canónicos. Única fuente: editar aquí y correr `npm run tokens`. Cada color es [Día, Noche].",
  "version": "2.0.0",
  "font": {
    "display": "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
    "ui": "Inter, ui-sans-serif, system-ui, sans-serif",
    "data": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "text": {
    "display": ["clamp(46px, 7vw, 108px)", "0.94"],
    "title": ["clamp(28px, 3.4vw, 44px)", "1.08"],
    "subtitle": ["20px", "1.3"],
    "body": ["16px", "1.55"],
    "ui": ["14px", "1.4"],
    "data": ["12.5px", "1.35"],
    "label": ["10.5px", "1.2"]
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "radius": { "xs": "6px", "sm": "12px", "md": "18px", "lg": "24px", "pill": "999px" },
  "duration": { "instant": "90ms", "quick": "140ms", "bridge": "200ms", "reveal": "280ms", "trace": "520ms", "slow": "720ms", "pulse": "1400ms" },
  "ease": { "out": "cubic-bezier(.2, .8, .2, 1)", "in": "cubic-bezier(.5, 0, .75, 0)", "firm": "cubic-bezier(.65, 0, .35, 1)" },
  "neutral": {
    "000": ["#FFFEFA", "#0E1113"],
    "050": ["#F7F6F1", "#14171A"],
    "100": ["#EDEFE9", "#1B1F22"],
    "200": ["#DDE2DC", "#252A2E"],
    "300": ["#C6CDC6", "#333A3E"],
    "400": ["#A7B1A9", "#465055"],
    "500": ["#7E8A84", "#5E6A6F"],
    "600": ["#5C6A6F", "#8B9599"],
    "700": ["#3F4A50", "#B4BDC0"],
    "900": ["#14171A", "#F2F4F3"]
  },
  "semantic": {
    "paper": ["neutral.050", "neutral.050"],
    "surface": ["neutral.000", "neutral.100"],
    "sunken": ["neutral.100", "neutral.000"],
    "line-soft": ["neutral.200", "neutral.200"],
    "line": ["neutral.300", "neutral.300"],
    "line-strong": ["neutral.400", "neutral.400"],
    "ink": ["neutral.900", "neutral.900"],
    "ink-strong": ["neutral.700", "neutral.700"],
    "ink-2": ["neutral.600", "neutral.600"]
  },
  "brand": {
    "accent": ["#1AA57A", "#1AA57A"],
    "ink": ["#13805E", "#1AA57A"],
    "on-accent": ["#0E1113", "#0E1113"]
  },
  "family": {
    "nucleo": ["#1AA57A", "#1AA57A"],
    "analisis": ["#ED4B46", "#FF8E80"],
    "modelo": ["#7657D5", "#A990FF"],
    "civil": ["#468C09", "#72CF4A"],
    "proyecto": ["#D9720A", "#F3C553"],
    "conexiones": ["#3A72E3", "#72A1FF"],
    "aprendizaje": ["#C94A8F", "#F07DB5"]
  },
  "signal": {
    "axial": ["#0F95D1", "#63C5FF"],
    "moment": ["#ED4B46", "#FF8E80"],
    "shear": ["#468C09", "#55C990"],
    "deformed": ["#8B5CF6", "#9B87FF"],
    "yield": ["#D85AC9", "#EF7AB9"],
    "attention": ["#D9720A", "#F3C553"]
  },
  "status": {
    "available": ["#277654", "#55C990"],
    "experimental": ["#8A6110", "#F3C553"],
    "planned": ["#5C6A6F", "#8B9599"],
    "uncommitted": ["#A7B1A9", "#5E6A6F"]
  },
  "light": {
    "highlight": ["rgb(255 255 255 / 85%)", "rgb(255 255 255 / 16%)"],
    "shade": ["rgb(20 23 26 / 14%)", "rgb(0 0 0 / 55%)"],
    "shade-soft": ["rgb(20 23 26 / 8%)", "rgb(0 0 0 / 35%)"],
    "shade-strong": ["rgb(20 23 26 / 22%)", "rgb(0 0 0 / 70%)"]
  },
  "shadow": {
    "inset": "inset 2px 2.5px 5px {shade}, inset -1.5px -1.5px 3px {highlight}",
    "raised": "2px 4px 7px -1px {shade}, 1px 1px 2px {shade}, inset 1.5px 1.5px 2px {highlight}, inset -2px -2px 4px {shade-soft}",
    "float": "4px 8px 14px -2px {shade-strong}, 1px 2px 4px {shade}, inset 1.5px 1.5px 2px {highlight}, inset -2px -2px 4px {shade-soft}",
    "sheet": "0 -6px 12px -2px {shade-strong}, inset 1px 1px 2px {highlight}",
    "lifted": "5px 10px 16px -2px {shade-strong}, 2px 3px 5px {shade}, inset 2px 2px 3px {highlight}",
    "selected": "inset 2px 2.5px 5px {shade}, inset -1px -1px 2px {highlight}, 0 0 0 1.5px var(--fs-brand-accent)"
  }
}
